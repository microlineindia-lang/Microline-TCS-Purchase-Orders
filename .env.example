# Copy this file to ".env" for local runs. NEVER commit the real .env.
# On a hosting platform, add these as Secrets / Environment Variables instead.

# ---------- Required: data ----------
# Sheet id = the long string in the Sheet URL between /d/ and /edit
TCS_SPREADSHEET_ID=
# Gmail App Password for microlineindia@gmail.com (16 chars, spaces are ignored)
TCS_GMAIL_APP_PASSWORD=

# Google service-account key. Use ONE of these two:
# (a) the whole JSON key file pasted as one line (best for hosting platforms)
GOOGLE_SERVICE_ACCOUNT_JSON=
# (b) path to the key file (best for running on your own PC)
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# ---------- Required: login ----------
# OAuth "Web application" client id from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
# Long random string that signs login cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TCS_SESSION_SECRET=
# Comma-separated list of Google accounts allowed in
TCS_ALLOWED_EMAILS=microlineindia@gmail.com

# ---------- Optional ----------
TCS_WORKSHEET_NAME=Orders
TCS_META_WORKSHEET=Meta
TCS_TIMEZONE=Asia/Kolkata
TCS_AUTO_REFRESH_TIME=08:00
TCS_SESSION_HOURS=12

# Secret for the daily auto-refresh endpoint (GitHub Actions sends it).
# Generate a different random string. Leave empty to disable the endpoint.
TCS_CRON_TOKEN=
# Only if the app runs on your own always-on PC (not with GitHub Actions):
# TCS_AUTO_REFRESH_LOCAL=1

# LOCAL TESTING ONLY - turns the login OFF. Never set this on a hosted app.
# TCS_AUTH_DISABLED=1
